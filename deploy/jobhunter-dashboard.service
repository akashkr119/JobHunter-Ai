[Unit]
Description=JobHunter-Ai Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__JOBHUNTER_USER__
WorkingDirectory=__JOBHUNTER_DIR__
EnvironmentFile=-__JOBHUNTER_DIR__/.env
ExecStart=__JOBHUNTER_DIR__/.venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 1 --threads 4 --timeout 600 dashboard.app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
