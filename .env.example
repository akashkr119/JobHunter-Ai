# JobHunter AI V1 configuration template
# Copy this file to .env and replace values for your environment.
# Never commit .env, notification credentials, or private resume data.

# Core application
JOBHUNTER_DATABASE_PATH=database/jobs.db
JOBHUNTER_RESUME_PATH=resume.pdf
JOBHUNTER_MIN_MATCH_SCORE=60
JOBHUNTER_SCHEDULER_HOURS=6

# Target profile
JOBHUNTER_TARGET_TITLES=QA Automation Engineer,SDET
JOBHUNTER_PREFERRED_LOCATIONS=Bengaluru,Remote
JOBHUNTER_WORK_MODES=remote,hybrid
JOBHUNTER_DESIRED_KEYWORDS=python,selenium,pytest
JOBHUNTER_EXCLUDED_KEYWORDS=intern

# Production runner
JOBHUNTER_LOG_LEVEL=INFO
JOBHUNTER_RUN_HISTORY_PATH=logs/run_history.jsonl
JOBHUNTER_RUN_LOCK_PATH=database/jobhunter.lock

# Smart alerts. Leave channel blank to disable notifications.
JOBHUNTER_NOTIFICATION_CHANNEL=
JOBHUNTER_NOTIFICATION_MIN_PRIORITY=high
JOBHUNTER_NOTIFICATION_MIN_RECOMMENDATION_SCORE=75

# Telegram (required only when channel=telegram)
JOBHUNTER_TELEGRAM_BOT_TOKEN=
JOBHUNTER_TELEGRAM_CHAT_ID=

# Email (required only when channel=email)
JOBHUNTER_SMTP_HOST=
JOBHUNTER_SMTP_PORT=587
JOBHUNTER_SMTP_USERNAME=
JOBHUNTER_SMTP_PASSWORD=
JOBHUNTER_SMTP_SENDER=
JOBHUNTER_EMAIL_RECIPIENT=
