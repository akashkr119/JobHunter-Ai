# JobHunter AI configuration
# Copy this file to .env and fill only the values you need.
# Never commit real passwords, API tokens, or personal credentials.

# Core application
JOBHUNTER_DATABASE_PATH=database/jobs.db
JOBHUNTER_RESUME_PATH=resume.pdf
JOBHUNTER_MIN_MATCH_SCORE=60
JOBHUNTER_SCHEDULER_HOURS=6

# Notification channel: leave blank, email, or telegram
JOBHUNTER_NOTIFICATION_CHANNEL=

# Telegram
JOBHUNTER_TELEGRAM_BOT_TOKEN=
JOBHUNTER_TELEGRAM_CHAT_ID=

# Email / SMTP
JOBHUNTER_SMTP_HOST=
JOBHUNTER_SMTP_PORT=587
JOBHUNTER_SMTP_USERNAME=
JOBHUNTER_SMTP_PASSWORD=
JOBHUNTER_SMTP_SENDER=
JOBHUNTER_EMAIL_RECIPIENT=
